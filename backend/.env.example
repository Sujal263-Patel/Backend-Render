STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=hi-IN

# STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v1

# LLM Answer Generation (Default: Gemini API Cloud)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Retrieval / Vector DB
RETRIEVER_TYPE=hybrid
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Official dataset: stream ai4bharat/MSMARCO-XI from Hugging Face
DATA_SOURCE=hf_lib
MSMARCO_LIMIT=500
MSMARCO_SPLIT=train
MSMARCO_CONFIG=hi
STRICT_DATASET_ONLY=true

TOP_K=5
MIN_RETRIEVAL_SCORE=0.08
GROUNDING_OVERLAP_THRESHOLD=0.12
